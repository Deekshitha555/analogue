<%- include("../partials/header") %>

<h1>Edit Student</h1>

<form
    action="/students/<%= student._id %>?_method=PATCH"
    method="POST"
>

    <label for="name">Name</label>

    <input
        id="name"
        type="text"
        name="name"
        value="<%= student.name %>"
        required
    >

    <label for="email">Email</label>

    <input
        id="email"
        type="email"
        name="email"
        value="<%= student.email %>"
        required
    >

    <label for="age">Age</label>

    <input
        id="age"
        type="number"
        name="age"
        value="<%= student.age %>"
        required
    >

    <label for="course">Course</label>

    <input
        id="course"
        type="text"
        name="course"
        value="<%= student.course %>"
        required
    >

    <button type="submit">
        Save Changes
    </button>

</form>

<%- include("../partials/footer") %>