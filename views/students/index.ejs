<%- include("../partials/header") %>

<h1>All Students</h1>

<a class="button" href="/students/new">
    Add New Student
</a>

<% if (students.length === 0) { %>

    <p>No students found.</p>

<% } else { %>

    <div class="student-list">

        <% students.forEach((student) => { %>

            <div class="student-card">

                <h2>
                    <%= student.name %>
                </h2>

                <p>
                    Email: <%= student.email %>
                </p>

                <p>
                    Age: <%= student.age %>
                </p>

                <p>
                    Course: <%= student.course %>
                </p>

                <a href="/students/<%= student._id %>">
                    View
                </a>

                <a href="/students/<%= student._id %>/edit">
                    Edit
                </a>

                <form
                    action="/students/<%= student._id %>?_method=DELETE"
                    method="POST"
                    class="inline-form"
                >
                    <button type="submit">
                        Delete
                    </button>
                </form>

            </div>

        <% }) %>

    </div>

<% } %>

<%- include("../partials/footer") %>